generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                        String    @id @default(auto()) @map("_id") @db.ObjectId
  email                     String    @unique
  name                      String?
  password                  String?
  role                      String? // 'admin', 'clo', 'juriste', etc.
  organization              String?
  isActive                  Boolean   @default(false)
  isSandbox                 Boolean   @default(false)
  registrationCode          String?
  registrationCodeExpiresAt DateTime?

  accounts  Account[]
  sessions  Session[]
  contracts Contract[]      @relation("UserContracts")
  templates VaultTemplate[] @relation("UserTemplates") // ✅ relation inverse nommée
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Contract {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  status      String
  summary     String? // 🧠 Résumé IA
  rawText     String? // 📄 Texte brut
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    String?
  tags        String?
  description String?
  fromTemplateId String? @db.ObjectId

  createdById String @db.ObjectId
  createdBy   User   @relation(fields: [createdById], references: [id], name: "UserContracts")
}

model VaultTemplate {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  category  String
  clauses   String[]
  tags      String[]
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String @db.ObjectId
  createdBy   User   @relation(fields: [createdById], references: [id], name: "UserTemplates") // ✅ inverse correspond à `templates` dans User
}
