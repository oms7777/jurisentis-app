generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                        String   @id @default(auto()) @map("_id") @db.ObjectId
  email                     String   @unique
  name                      String?
  password                  String?
  role                      String?      // 'admin', 'clo', 'juriste', etc.
  organization              String?
  isActive                  Boolean  @default(false)
  isSandbox                 Boolean  @default(false)
  registrationCode          String?
  registrationCodeExpiresAt DateTime?

  accounts                  Account[]
  sessions                  Session[]
  contracts                 Contract[] @relation("UserContracts")
}

model Account {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  userId             String  @db.ObjectId
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Contract {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String   @db.ObjectId
  user        User     @relation("UserContracts", fields: [createdBy], references: [id])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
